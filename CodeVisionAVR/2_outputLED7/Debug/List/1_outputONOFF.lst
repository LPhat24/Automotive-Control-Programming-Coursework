000095 9634      	ADIW R30,4
000096 91e4      	LPM  R30,Z
000097 30e0      	CPI  R30,0
000098 f411      	BRNE _0xB
000099 982a      	CBI  0x5,2
00009a c001      	RJMP _0xC
                 _0xB:
00009b 9a2a      	SBI  0x5,2
