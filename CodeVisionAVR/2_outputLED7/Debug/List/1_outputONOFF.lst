000087 30e0      	CPI  R30,0
000088 f411      	BRNE _0x7
000089 9829      	CBI  0x5,1
00008a c001      	RJMP _0x8
                 _0x7:
00008b 9a29      	SBI  0x5,1
                 _0x8:
                 ; 0000 0021     LEDd = digit[num][3];
00008c d064      	RCALL SUBOPT_0x0
00008d 9633      	ADIW R30,3
00008e 91e4      	LPM  R30,Z
00008f 30e0      	CPI  R30,0
000090 f411      	BRNE _0x9
000091 985d      	CBI  0xB,5
000092 c001      	RJMP _0xA
                 _0x9:
000093 9a5d      	SBI  0xB,5
                 _0xA:
                 ; 0000 0022     LEDe = digit[num][4];
