                 ;
                 ;// Turn off all segments of the 7-segment LED
                 ;void turn_off_segments()
                 ; 0000 0029 {
                 _turn_off_segments:
                 ; .FSTART _turn_off_segments
                 ; 0000 002A       LEDa = 0;
0000ae 985e      	CBI  0xB,6
                 ; 0000 002B       LEDb = 0;
0000af 9828      	CBI  0x5,0
                 ; 0000 002C       LEDc = 0;
0000b0 9829      	CBI  0x5,1
                 ; 0000 002D       LEDd = 0;
0000b1 985d      	CBI  0xB,5
                 ; 0000 002E       LEDe = 0;
0000b2 982a      	CBI  0x5,2
                 ; 0000 002F       LEDf = 0;
0000b3 982b      	CBI  0x5,3
                 ; 0000 0030       LEDg = 0;
0000b4 982c      	CBI  0x5,4
                 ; 0000 0031 }
0000b5 9508      	RET
