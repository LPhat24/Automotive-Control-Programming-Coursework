00007d 9631      	ADIW R30,1
00007e 91e4      	LPM  R30,Z
00007f 30e0      	CPI  R30,0
000080 f411      	BRNE _0x5
000081 9828      	CBI  0x5,0
000082 c001      	RJMP _0x6
                 _0x5:
000083 9a28      	SBI  0x5,0
