                 ;
                 ;void main(void)
                 ; 0000 0034 {
                 _main:
                 ; .FSTART _main
                 ; 0000 0035     // Crystal Oscillator division factor: 1
                 ; 0000 0036     #pragma optsize-
                 ; 0000 0037     CLKPR = (1<<CLKPCE);
0000b6 e8e0      	LDI  R30,LOW(128)
0000b7 93e0 0061 	STS  97,R30
                 ; 0000 0038     CLKPR = (0<<CLKPCE) | (0<<CLKPS3) | (0<<CLKPS2) | (0<<CLKPS1) | (0<<CLKPS0);
0000b9 e0e0      	LDI  R30,LOW(0)
0000ba 93e0 0061 	STS  97,R30
                 ; 0000 0039     #ifdef _OPTIMIZE_SIZE_
                 ; 0000 003A     #pragma optsize+
                 ; 0000 003B     #endif
                 ; 0000 003C 
                 ; 0000 003D     DDRD = 0x60;  // PD5, PD6 as outputs
0000bc e6e0      	LDI  R30,LOW(96)
0000bd b9ea      	OUT  0xA,R30
                 ; 0000 003E     DDRB = 0x1F;  // PB0..PB4 as outputs
0000be e1ef      	LDI  R30,LOW(31)
0000bf b9e4      	OUT  0x4,R30
                 ; 0000 003F 
                 ; 0000 0040     while (1)
                 _0x1F:
                 ; 0000 0041     {
