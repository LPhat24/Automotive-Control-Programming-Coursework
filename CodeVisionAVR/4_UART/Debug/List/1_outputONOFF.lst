00008a 9463      	INC  R6
00008b e4e0      	LDI  R30,LOW(64)
00008c 15e6      	CP   R30,R6
00008d f411      	BRNE _0x5
                 ; 0000 002D       {
                 ; 0000 002E       rx_counter0=0;
00008e 2466      	CLR  R6
