                 ;//----------ADC----------
                 ;// Voltage Reference: AVCC pin
                 ;#define ADC_VREF_TYPE ((0<<REFS1) | (1<<REFS0) | (0<<ADLAR))
                 ;
                 ;// Read the AD conversion result
                 ;unsigned int read_adc(unsigned char adc_input)
                 ; 0000 0014 {
                 _read_adc:
                 ; .FSTART _read_adc
                 ; 0000 0015 ADMUX=adc_input | ADC_VREF_TYPE;
00007a 93aa      	ST   -Y,R26
                 ;	adc_input -> Y+0
00007b 81e8      	LD   R30,Y
00007c 64e0      	ORI  R30,0x40
00007d 93e0 007c 	STS  124,R30
                 ; 0000 0016 // Delay needed for the stabilization of the ADC input voltage
                 ; 0000 0017 delay_us(10);
                +
00007f e385     +LDI R24 , LOW ( 53 )
                +__DELAY_USB_LOOP :
000080 958a     +DEC R24
000081 f7f1     +BRNE __DELAY_USB_LOOP
                 	__DELAY_USB 53
                 ; 0000 0018 // Start the AD conversion
                 ; 0000 0019 ADCSRA|=(1<<ADSC);
000082 91e0 007a 	LDS  R30,122
000084 64e0      	ORI  R30,0x40
000085 93e0 007a 	STS  122,R30
                 ; 0000 001A // Wait for the AD conversion to complete
                 ; 0000 001B while ((ADCSRA & (1<<ADIF))==0);
                 _0x3:
000087 91e0 007a 	LDS  R30,122
000089 71e0      	ANDI R30,LOW(0x10)
00008a f3e1      	BREQ _0x3
                 ; 0000 001C ADCSRA|=(1<<ADIF);
00008b 91e0 007a 	LDS  R30,122
00008d 61e0      	ORI  R30,0x10
00008e 93e0 007a 	STS  122,R30
                 ; 0000 001D return ADCW;
000090 91e0 0078 	LDS  R30,120
000092 91f0 0079 	LDS  R31,120+1
000094 c0ba      	RJMP _0x2060001
                 ; 0000 001E }
