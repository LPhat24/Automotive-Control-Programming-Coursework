                 ; 0000 000A {
                 
                 	.CSEG
                 _read_adc:
                 ; .FSTART _read_adc
                 ; 0000 000B ADMUX=adc_input | ADC_VREF_TYPE;
000073 93aa      	ST   -Y,R26
                 ;	adc_input -> Y+0
000074 81e8      	LD   R30,Y
000075 64e0      	ORI  R30,0x40
000076 93e0 007c 	STS  124,R30
                 ; 0000 000C // Delay needed for the stabilization of the ADC input voltage
                 ; 0000 000D delay_us(10);
                +
000078 e385     +LDI R24 , LOW ( 53 )
                +__DELAY_USB_LOOP :
000079 958a     +DEC R24
00007a f7f1     +BRNE __DELAY_USB_LOOP
                 	__DELAY_USB 53
                 ; 0000 000E // Start the AD conversion
                 ; 0000 000F ADCSRA|=(1<<ADSC);
00007b 91e0 007a 	LDS  R30,122
00007d 64e0      	ORI  R30,0x40
00007e 93e0 007a 	STS  122,R30
                 ; 0000 0010 // Wait for the AD conversion to complete
                 ; 0000 0011 while ((ADCSRA & (1<<ADIF))==0);
                 _0x3:
000080 91e0 007a 	LDS  R30,122
000082 71e0      	ANDI R30,LOW(0x10)
000083 f3e1      	BREQ _0x3
                 ; 0000 0012 ADCSRA|=(1<<ADIF);
000084 91e0 007a 	LDS  R30,122
000086 61e0      	ORI  R30,0x10
000087 93e0 007a 	STS  122,R30
                 ; 0000 0013 return ADCW;
000089 91e0 0078 	LDS  R30,120
00008b 91f0 0079 	LDS  R31,120+1
00008d c0be      	RJMP _0x2060001
                 ; 0000 0014 }
